{
  "name": "skill-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "SkillBridge LMS with Full AI Integration",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "node Backend/index.js",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:all": "npm run dev",
    "dev:backend": "npm run dev --prefix Backend",
    "dev:frontend": "npm run dev --prefix Frontend",
    "install:all": "npm install && npm install --prefix Backend && npm install --prefix Frontend",
    "build": "npm run build --prefix Frontend",
    "postinstall": "npm run prisma:generate --prefix Backend || true"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "adm-zip": "^0.6.0",
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "fast-xml-parser": "^5.11.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.1",
    "msedge-tts": "^2.1.1",
    "multer": "^2.2.0",
    "nodemailer": "^10.1.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.1",
    "tesseract.js": "^5.1.1"
  }
}
