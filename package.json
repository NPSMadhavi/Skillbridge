{
  "name": "skillbridge-root",
  "version": "1.0.0",
  "private": true,
  "description": "SkillBridge LMS Production Deployment",
  "type": "module",
  "main": "Backend/index.js",
  "scripts": {
    "start": "node Backend/index.js",
    "postinstall": "npm install --prefix Backend && npm --prefix Backend run prisma:generate",
    "install:backend": "npm install --prefix Backend",
    "install:frontend": "npm install --prefix Frontend",
    "install:all": "npm install --prefix Backend && npm install --prefix Frontend",
    "prisma:generate": "npm --prefix Backend run prisma:generate",
    "seed:superadmin": "npm --prefix Backend run seed:superadmin",
    "build:frontend": "npm --prefix Frontend run build",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix Backend",
    "dev:frontend": "npm run dev --prefix Frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
