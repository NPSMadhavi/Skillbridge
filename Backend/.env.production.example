# SkillBridge Production Environment Template (Plesk Linux / Passenger)
PORT=passenger
NODE_ENV=production
APP_URL=https://brutallyhired.com
FRONTEND_URL=https://brutallyhired.com

# Production PostgreSQL Database Connections
# (Configure with production DB user, password, and port on Plesk host)
MASTER_DATABASE_URL="postgresql://db_user:strong_password@127.0.0.1:5432/skillbridge_master?schema=public"
DB_BASE_URL="postgresql://db_user:strong_password@127.0.0.1:5432"
DATABASE_URL="postgresql://db_user:strong_password@127.0.0.1:5432/skillbridge?schema=public"

# Cryptographically Secure 256-bit Production JWT Secret (Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_strong_64_character_hex_secret_in_production
AUTH_RATE_LIMIT_MAX=100
GENERAL_RATE_LIMIT_MAX=3000

# Central AI Gateway (Public HTTPS Tailscale Funnel to Ubuntu RTX GPU server)
# Note: Tailscale is installed on the Ubuntu server. Plesk connects via standard HTTPS without local Tailscale.
SKILLBRIDGE_LLM_GATEWAY_URL="https://rtxsvr.tail59469f.ts.net"
SKILLBRIDGE_LLM_GATEWAY_API_KEY="d52edbbeb11ee8b323282d10fe030b6f71667984d8199b8e4f67ed7513fb7387"

# Python AI Service
PYTHON_SERVICE_URL="https://rtxsvr.tail59469f.ts.net"

# SMTP / Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@domain.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@domain.com
