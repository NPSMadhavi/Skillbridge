datasource db {
  provider = "postgresql"
  url      = env("MASTER_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/master-client"
}

model SuperAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

model Company {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique
  dbName       String   @unique
  dbUrl        String
  status       String   @default("ACTIVE")
  adminEmail   String
  fullName     String?
  nricFin      String?
  phone        String?
  department   String?
  aiName        String   @default("ARIA")
  wakeWord      String?

  aiVoiceGender String?  @default("FEMALE")
  aiVoiceName   String?  @default("Veda")
  aiVoiceRate   Float?   @default(1.0)
  aiVoicePitch  Float?   @default(1.0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}


