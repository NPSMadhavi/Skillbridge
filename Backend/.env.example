PORT=5000
NODE_ENV=development
APP_URL=https://brutallyhired.com/
FRONTEND_URL=https://brutallyhired.com/

# PostgreSQL Database Connections
MASTER_DATABASE_URL="postgresql://postgres:password@localhost:5432/skillbridge_master?schema=public"
DB_BASE_URL="postgresql://postgres:password@localhost:5432"
DATABASE_URL="postgresql://postgres:password@localhost:5432/skillbridge?schema=public"

# Authentication Security
JWT_SECRET=super-secret-key-change-in-prod
AUTH_RATE_LIMIT_MAX=100
GENERAL_RATE_LIMIT_MAX=3000
# RATE_LIMIT_DISABLED=false

# Central SkillBridge LLM Gateway (Chat: /api/v1/chat, /health, /api/v1/models)
SKILLBRIDGE_LLM_GATEWAY_URL=
SKILLBRIDGE_LLM_GATEWAY_API_KEY=

# Python AI Service (Local microservice on Ubuntu server running on port 8000)
PYTHON_SERVICE_URL=http://127.0.0.1:8000

# SMTP / Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
