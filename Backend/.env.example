# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-domain.com

# PostgreSQL Database Connections (DO NOT hardcode credentials in code)
DATABASE_URL=postgresql://user:password@localhost:5432/skillbridge?schema=public
MASTER_DATABASE_URL=postgresql://user:password@localhost:5432/skillbridge_master?schema=public

# Authentication Security (Must be a cryptographically strong secret in production)
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key

# Python AI Service
PYTHON_SERVICE_URL=http://localhost:8000

# LLM Gateway / OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SKILLBRIDGE_LLM_GATEWAY_URL=
SKILLBRIDGE_LLM_GATEWAY_API_KEY=

# SMTP / Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM="SkillBridge Platform" <noreply@skillbridge.com>

# Super Admin Initial Setup
SUPER_ADMIN_EMAIL=superadmin@skillbridge.com
SUPER_ADMIN_PASSWORD=change_this_strong_password!

